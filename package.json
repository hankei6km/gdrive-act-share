{
  "name": "@hankei6km/gdrive-act-share",
  "version": "0.3.25",
  "description": "This action shares a file in Google Drive.",
  "author": "hankei6km <hankei6km@gmail.com> (https://github.com/hankei6km)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hankei6km/gdrive-act-share"
  },
  "bugs": {
    "url": "https://github.com/hankei6km/gdrive-act-share/issues"
  },
  "keywords": [],
  "main": "dist/index.mjs",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "npm run clean",
    "build": "node esbuild.config.mjs",
    "postbuild": "npm run gen-readme",
    "gen-readme": "bash scripts/gen-readme.sh",
    "test": "node --experimental-strip-types --test",
    "test:coverage": "npm run test -- --experimental-test-coverage",
    "test:build": "npm run build && npm run test",
    "clean": "test ! -d dist || rm -r dist",
    "lint:types": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "guratan": "^0.8.6"
  },
  "devDependencies": {
    "@hankei6km/files-to-licenses": "^0.1.1",
    "@types/node": "^26.2.0",
    "action-docs": "^2.5.1",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2"
  }
}
